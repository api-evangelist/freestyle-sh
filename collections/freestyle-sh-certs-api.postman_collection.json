          "name": "Provision a Wildcard Certificate",
          "request": {
            "name": "Provision a Wildcard Certificate",
            "description": {
              "content": "Provisions a wildcard certificate for a verified domain\n\n\nThis speeds up deploys on all subdomains of the domain. In order to use it, you must add the following record to your DNS config:\n\n`_acme-challenge.yourdomain.com` NS `dns.freestyle.sh`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "domains",
                "v1",
                "certs",
                ":domain",
                "wildcard"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "domain",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
